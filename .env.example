# MinhaTela API
API_PORT=4000
# Em Railway usa-se PORT (injectado automaticamente)
# PORT=4000
API_BASE_URL=http://localhost:4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
# Access token curto + refresh longo (padrão enterprise)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# Produção: URL(s) do frontend Vercel, separadas por vírgula
# CORS_ORIGIN=https://minhatela.vercel.app
CORS_ORIGIN=true

# PostgreSQL
# Host: 55432 (Docker). Dentro da rede compose continua @postgres:5432
# Railway: DATABASE_URL vem do plugin PostgreSQL
DATABASE_URL=postgresql://minhatela:minhatela@localhost:55432/minhatela

# Bunny.net Stream (server-only secrets)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_EMBED_BASE_URL=https://iframe.mediadelivery.net/embed
BUNNY_TOKEN_AUTH_KEY=
# Produção: exigir Token Auth (SHA-256) em todas as URLs de playback
BUNNY_REQUIRE_TOKEN=false
# Opcional: amarrar token ao IP do cliente (mais seguro, menos CDN hit)
BUNNY_TOKEN_AUTH_WITH_IP=false
PLAYBACK_TTL_SECONDS=14400

# Pagamentos Angola
PLATFORM_IBAN=AO06.0000.0000.0000.0000.0000.0
PLATFORM_BANK_NAME=Banco Atlântico
PLATFORM_ACCOUNT_NAME=MinhaTela Lda
PLATFORM_MULTICAIXA_REF=

# Monetização (Kz inteiros)
PREMIUM_PRICE_KZ=4990
TVOD_DEFAULT_PRICE_KZ=1500
TVOD_RENTAL_HOURS=48

# Streams simultâneos (Netflix-style)
MAX_CONCURRENT_STREAMS_FREE=1
MAX_CONCURRENT_STREAMS_PREMIUM=2
STREAM_HEARTBEAT_TTL_SECONDS=90

# Downloads offline
DOWNLOAD_MAX_FREE=3
DOWNLOAD_MAX_PREMIUM=10
DOWNLOAD_TTL_DAYS_FREE=7
DOWNLOAD_TTL_DAYS_PREMIUM=30

# Expo (apenas URL pública da API — NUNCA secrets)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_APP_PUBLIC_URL=http://localhost:8081

# App pública (deep links · share · reset password)
# Produção: URL do Vercel
APP_PUBLIC_URL=http://localhost:8081

# Bunny webhook (POST /webhooks/bunny?token=...)
BUNNY_WEBHOOK_SECRET=

# Jobs internos (estreias automáticas · purge contas)
JOBS_ENABLED=true
JOBS_INTERVAL_MS=60000
ACCOUNT_DELETION_GRACE_DAYS=30

# Deploy (Railway) — seed no boot (só 1ª vez)
SEED_ON_BOOT=false
SUPERADMIN_EMAIL=minhatela2026@gmail.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin MinhaTela
