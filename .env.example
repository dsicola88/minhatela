# ═══════════════════════════════════════════════════════════
# MinhaTela · variáveis de ambiente
# Domínios: minhatela.net (principal) · minhatela.ao (secundário)
# ═══════════════════════════════════════════════════════════

# --- Runtime ---
NODE_ENV=production
API_PORT=4000
# Railway injecta PORT automaticamente
# PORT=8080

# URLs públicas
# API: api.minhatela.net  ·  Web: minhatela.net (+ minhatela.ao)
API_BASE_URL=https://api.minhatela.net
APP_PUBLIC_URL=https://minhatela.net
CORS_ORIGIN=https://minhatela.net,https://www.minhatela.net,https://minhatela.ao,https://www.minhatela.ao

PRIMARY_DOMAIN=minhatela.net
SECONDARY_DOMAIN=minhatela.ao
MARKET_COUNTRY=AO
MARKET_TIMEZONE=Africa/Luanda
MARKET_LOCALE=pt-AO

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- PostgreSQL ---
# Railway: ligado automaticamente ao plugin Postgres
DATABASE_URL=postgresql://minhatela:minhatela@localhost:55432/minhatela

# --- Email (SMTP) ---
# Ex.: Resend, Mailgun, Amazon SES, ou o SMTP do teu registo de domínio
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MinhaTela <noreply@minhatela.net>
SMTP_REPLY_TO=support@minhatela.net
MAIL_SUPPORT=support@minhatela.net
MAIL_CONTACT=contato@minhatela.net
MAIL_NOREPLY=noreply@minhatela.net

# --- Bunny.net Stream (server-only) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_EMBED_BASE_URL=https://iframe.mediadelivery.net/embed
BUNNY_TOKEN_AUTH_KEY=
BUNNY_REQUIRE_TOKEN=true
BUNNY_TOKEN_AUTH_WITH_IP=false
BUNNY_WEBHOOK_SECRET=
PLAYBACK_TTL_SECONDS=14400

# --- Pagamentos Angola ---
PLATFORM_IBAN=
PLATFORM_BANK_NAME=Banco Atlântico
PLATFORM_ACCOUNT_NAME=MinhaTela Lda
PLATFORM_MULTICAIXA_REF=

# --- Monetização (Kz) ---
PREMIUM_PRICE_KZ=4990
TVOD_DEFAULT_PRICE_KZ=1500
TVOD_RENTAL_HOURS=48

# --- Streams / downloads ---
MAX_CONCURRENT_STREAMS_FREE=1
MAX_CONCURRENT_STREAMS_PREMIUM=2
STREAM_HEARTBEAT_TTL_SECONDS=90
DOWNLOAD_MAX_FREE=3
DOWNLOAD_MAX_PREMIUM=10
DOWNLOAD_TTL_DAYS_FREE=7
DOWNLOAD_TTL_DAYS_PREMIUM=30

# --- Jobs ---
JOBS_ENABLED=true
JOBS_INTERVAL_MS=60000
ACCOUNT_DELETION_GRACE_DAYS=30

# --- Seed (só 1.ª vez em produção) ---
SEED_ON_BOOT=false
SUPERADMIN_EMAIL=minhatela2026@gmail.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin MinhaTela

# --- Expo Web (Vercel · Root Directory = mobile) ---
# Nunca colocar secrets aqui
EXPO_PUBLIC_API_BASE_URL=https://api.minhatela.net
EXPO_PUBLIC_APP_PUBLIC_URL=https://minhatela.net
