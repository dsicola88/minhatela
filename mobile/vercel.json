{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/share/:id",
      "destination": "https://minhatela-production.up.railway.app/share/:id"
    },
    {
      "source": "/robots.txt",
      "destination": "https://minhatela-production.up.railway.app/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://minhatela-production.up.railway.app/sitemap.xml"
    },
    {
      "source": "/((?!_expo|assets|favicon\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
